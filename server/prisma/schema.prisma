generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ROLES Y PERMISOS
// ============================================

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.VarChar(255)
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  usuarios  Usuario[]
  permisos  Permiso[]

  @@map("roles")
}

model Permiso {
  id      Int    @id @default(autoincrement())
  rolId   Int
  rol     Rol    @relation(fields: [rolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modulo  String @db.VarChar(30) // VENTAS | COBRANZAS | RECEPCION | CONFIGURACION
  leer    Boolean @default(false)
  crear   Boolean @default(false)
  editar  Boolean @default(false)
  eliminar Boolean @default(false)
  verTodos Boolean @default(false) // true = ve todos los registros, false = solo los propios

  @@unique([rolId, modulo])
  @@map("permisos")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model Usuario {
  id            Int       @id @default(autoincrement())
  nombre        String    @db.VarChar(100)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(255)
  passwordVisible String? @db.VarChar(255)
  rolId         Int
  rol           Rol       @relation(fields: [rolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  activo        Boolean   @default(true)
  fechaCreacion DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  contratos              Contrato[]
  cuotasRegistradas      Cuota[]     @relation("CuotaRegistradaPor")
  pagosRegistrados       CuotaPago[] @relation("PagoRegistradoPor")
  recepcionesRegistradas   Recepcion[] @relation("RecepcionRegistradaPor")
  observacionesCuota       CuotaObservacion[] @relation("ObservacionCreadaPor")
  historialRecepcion       RecepcionHistorial[] @relation("HistorialCreadoPor")

  @@map("usuarios")
}

// ============================================
// CONTRATOS (Solicitud de Pedido)
// ============================================

model Contrato {
  id               Int      @id @default(autoincrement())
  numeroContrato   String   @unique @db.VarChar(50)

  // -- Punto de venta --
  puntoVenta       String   @db.VarChar(20)  // SALON | STAND | OTRO
  productorAsesor  String   @db.VarChar(150)

  // -- Vehículo solicitado --
  tipoVehiculo     String   @db.VarChar(20)  // AUTO | UTILITARIO | CAMIONETA | MOTO | OTRO
  marca            String   @db.VarChar(100)
  modelo           String   @db.VarChar(100)

  // -- Pago --
  anticipoMensual  Decimal  @db.Decimal(12, 2)
  montoSellado     Decimal? @db.Decimal(12, 2)
  periodoPago      String   @db.VarChar(10)  // "1-10" | "10-20" | "20-30"
  cantidadCuotas   Int

  // -- Datos del solicitante --
  solicitanteNombre      String  @db.VarChar(200)
  solicitanteDni         String  @db.VarChar(20)
  solicitanteFechaNac    DateTime?
  solicitanteEstadoCivil String? @db.VarChar(30)
  solicitanteDomicilio   String? @db.VarChar(255)
  solicitanteBarrio      String? @db.VarChar(100)
  solicitanteLocalidad   String? @db.VarChar(100)
  solicitanteCp          String? @db.VarChar(10)
  solicitanteProvincia   String? @db.VarChar(100)
  solicitanteCelular     String? @db.VarChar(50)
  solicitanteTelFijo     String? @db.VarChar(50)
  solicitanteHrContacto  String? @db.VarChar(50)
  solicitanteOcupacion   String? @db.VarChar(100)
  solicitanteEmail       String? @db.VarChar(255)

  // -- Datos del cónyuge (opcional) --
  conyugeNombre    String? @db.VarChar(200)
  conyugeDni       String? @db.VarChar(20)
  conyugeFechaNac  DateTime?
  conyugeTelefono  String? @db.VarChar(50)

  // -- Vehículo usado (condicional) --
  tieneVehiculoUsado Boolean @default(false)
  usadoMarca         String? @db.VarChar(100)
  usadoModelo        String? @db.VarChar(100)
  usadoAnio          Int?
  usadoColor         String? @db.VarChar(50)
  usadoCombustible   String? @db.VarChar(50)

  // -- Otros --
  comoLlego      String? @db.VarChar(255)
  observaciones  String? @db.Text

  // -- Control --
  montoDevolucion Decimal? @db.Decimal(12, 2)
  estado          String   @default("ACTIVO") @db.VarChar(20) // ACTIVO | NEGOCIACION | COMPLETADO | CANCELADO | DE_BAJA | DEVOLUCION

  // -- Financiamiento (al completar con saldo) --
  tipoFinanciamiento       String?  @db.VarChar(20) // SIN_SALDO | EXTERNO | CASA
  financiamientoCuotas     Int?
  financiamientoValorCuota Decimal? @db.Decimal(12, 2)
  financiamientoTasa       Decimal? @db.Decimal(5, 2)
  registradoPorId Int
  registradoPor   Usuario  @relation(fields: [registradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fechaCreacion   DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // -- Relaciones --
  archivos ContratoArchivo[]
  cuotas   Cuota[]

  @@map("contratos")
}

// ============================================
// ARCHIVOS DE CONTRATO (Cloudinary)
// ============================================

model ContratoArchivo {
  id         Int      @id @default(autoincrement())
  contratoId Int
  contrato   Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tipo       String   @db.VarChar(20) // CONTRATO | DNI_FRENTE | DNI_DORSO | FOTO_AUTO
  url        String   @db.VarChar(500)
  publicId   String   @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@map("contrato_archivos")
}

// ============================================
// CUOTAS (Cobranzas)
// ============================================

model Cuota {
  id               Int      @id @default(autoincrement())
  contratoId       Int
  contrato         Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  numeroCuota      Int
  monto            Decimal  @db.Decimal(12, 2)
  fechaVencimiento DateTime
  tipo             String   @default("REGULAR") @db.VarChar(20) // REGULAR | ANTICIPO | FINANCIAMIENTO
  estado           String   @default("PENDIENTE") @db.VarChar(20) // PENDIENTE | PAGADA | VENCIDA | PARCIAL | DE_BAJA
  montoPagado      Decimal? @db.Decimal(12, 2)
  formaPago        String?  @db.VarChar(50)  // EFECTIVO | TRANSFERENCIA | TARJETA | etc.
  fechaPago        DateTime?
  registradoPorId  Int?
  registradoPor    Usuario? @relation("CuotaRegistradaPor", fields: [registradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  observaciones    String?  @db.VarChar(500)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relaciones
  pagos            CuotaPago[]
  observacionesLog CuotaObservacion[]
  comprobantes     CuotaComprobante[]

  @@map("cuotas")
}

// ============================================
// PAGOS DE CUOTA (múltiples pagos por cuota)
// ============================================

model CuotaPago {
  id              Int      @id @default(autoincrement())
  cuotaId         Int
  cuota           Cuota    @relation(fields: [cuotaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  monto           Decimal  @db.Decimal(12, 2)
  formaPago       String   @db.VarChar(50) // EFECTIVO | TRANSFERENCIA | TARJETA | DEBITO | CHEQUE | DEPOSITO
  fechaPago       DateTime
  observaciones   String?  @db.VarChar(500)
  registradoPorId Int
  registradoPor   Usuario  @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime @default(now())

  @@map("cuota_pagos")
}

// ============================================
// OBSERVACIONES DE CUOTA (Log con fecha/hora)
// ============================================

model CuotaObservacion {
  id          Int      @id @default(autoincrement())
  cuotaId     Int
  cuota       Cuota    @relation(fields: [cuotaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  texto       String   @db.VarChar(500)
  creadoPorId Int
  creadoPor   Usuario  @relation("ObservacionCreadaPor", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())

  @@map("cuota_observaciones")
}

// ============================================
// COMPROBANTES DE PAGO (Cloudinary)
// ============================================

model CuotaComprobante {
  id        Int      @id @default(autoincrement())
  cuotaId   Int
  cuota     Cuota    @relation(fields: [cuotaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  url       String   @db.VarChar(500)
  publicId  String   @db.VarChar(255)
  createdAt DateTime @default(now())

  @@map("cuota_comprobantes")
}

// ============================================
// RECEPCIÓN (Contactos / Visitas)
// ============================================

model Recepcion {
  id              Int       @id @default(autoincrement())
  nombre          String    @db.VarChar(200)
  telefono        String?   @db.VarChar(50)
  email           String?   @db.VarChar(255)
  medio           String    @db.VarChar(20)  // PRESENCIAL | TELEFONO | WHATSAPP | EMAIL | WEB | OTRO
  motivo          String?   @db.VarChar(500)
  observaciones   String?   @db.Text
  comoLlego       String?   @db.VarChar(100) // Instagram | Facebook | Radio | Recomendación | etc.

  // -- Seguimiento --
  estado          String    @default("PENDIENTE") @db.VarChar(20) // PENDIENTE | CONTACTADO | CITA_AGENDADA | CERRADO
  fechaCita       DateTime?
  notasCita       String?   @db.VarChar(500)

  registradoPorId Int?
  registradoPor   Usuario?  @relation("RecepcionRegistradaPor", fields: [registradoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fechaContacto   DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  historial RecepcionHistorial[]

  @@map("recepciones")
}

// ============================================
// HISTORIAL DE RECEPCIÓN (Log de cambios)
// ============================================

model RecepcionHistorial {
  id           Int       @id @default(autoincrement())
  recepcionId  Int
  recepcion    Recepcion @relation(fields: [recepcionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  tipo         String    @db.VarChar(30) // CREADA | REAGENDADA | ESTADO_CAMBIADO | EDITADA
  descripcion  String    @db.VarChar(500)
  creadoPorId  Int
  creadoPor    Usuario   @relation("HistorialCreadoPor", fields: [creadoPorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt    DateTime  @default(now())

  @@map("recepcion_historial")
}
